  "license": "UNLICENSED",
  "keywords": [
    "captcha",
    "bot",
    "anti-bot",
    "proof-of-work",
    "web-component",
    "botguard"
  ],
  "homepage": "https://github.com/dkeepersun/BotGuard/tree/main/packages/browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkeepersun/BotGuard.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/dkeepersun/BotGuard/issues"
  },
  "exports": {
    ".": "./src/botguard.js",
    "./signals": "./src/signals.js",
    "./solver": "./src/solver.js",
    "./worker": "./src/worker.js",
    "./load": "./src/load.js"
  },
  "files": [
    "src/",
    "README.md"
