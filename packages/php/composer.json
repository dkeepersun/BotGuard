{
    "name": "botguard/php-sdk",
    "description": "BotGuard 服务端核验 SDK：签名调用 /v1/verify，按 Passed / Rejected / CallerError / Unknown 返回结果",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "BotGuard\\": "src/"
        }
    },
    "homepage": "https://github.com/dkeepersun/BotGuard",
    "keywords": [
        "captcha",
        "bot",
        "anti-bot",
        "verification",
        "botguard"
    ],
    "support": {
        "issues": "https://github.com/dkeepersun/BotGuard/issues",
        "source": "https://github.com/dkeepersun/BotGuard"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
