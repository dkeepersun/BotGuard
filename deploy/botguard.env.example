# gateway、admin-web 和 botguard-ctl 共用的环境变量。复制到 /etc/botguard/botguard.env：
#   sudo install -d -m 0755 /etc/botguard
#   sudo install -m 0600 deploy/botguard.env.example /etc/botguard/botguard.env
# systemd 的 EnvironmentFile 和 shell 都能读这个格式：KEY='value'，不要写 export。
# 值里有单引号以外的特殊字符（括号、斜杠、等号）时用单引号括起来。

# MySQL ≥ 8.0 或 MariaDB ≥ 10.5.2
BOTGUARD_MYSQL_DSN='botguard:password@tcp(127.0.0.1:3306)/botguard'

# challenge 签名密钥：openssl rand -base64 32
BOTGUARD_CHALLENGE_KEY_K1=''

# 加密应用密钥和动态码的 KEK：echo "k1:$(openssl rand -base64 32)"
# gateway、admin-web、botguard-ctl 必须一致；生成后不要再改，轮换见 README「升级」。
BOTGUARD_SECRET_KEK=''
BOTGUARD_SECRET_KEK_PREVIOUS=''

# gateway 的公开地址（写进接入代码），以及管理后台检查 gateway 状态用的地址。
BOTGUARD_PUBLIC_ENDPOINT='https://botguard.example.com'
BOTGUARD_GATEWAY_URL='http://127.0.0.1:8090'
