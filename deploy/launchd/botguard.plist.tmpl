<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd 服务模板，由 scripts/botguard.sh install-launchd 渲染成
  ~/Library/LaunchAgents/com.botguard.gateway.plist 和 com.botguard.admin-web.plist。
  不要直接复制：__XXX__ 占位符会被替换成程序目录和服务名。
  服务以当前用户运行，登录后自动启动，退出后 launchd 自动拉起。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.botguard.__SERVICE__</string>
  <!-- botguard.sh run 加载 botguard.env 里的密钥后 exec 程序。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/botguard.sh</string>
    <string>run</string>
    <string>__SERVICE__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- 配置错误时不要每秒重启刷日志。 -->
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/__SERVICE__.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/__SERVICE__.log</string>
</dict>
</plist>
